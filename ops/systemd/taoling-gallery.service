[Unit]
Description=Taoling Gallery Node.js API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=taoling
Group=taoling
WorkingDirectory=/opt/taoling-gallery/current/taoling-gallery-server
Environment=NODE_ENV=production
EnvironmentFile=/etc/taoling-gallery/server.env
ExecStart=/usr/bin/node src/server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
KillSignal=SIGTERM

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/taoling-gallery/uploads

StandardOutput=journal
StandardError=journal
SyslogIdentifier=taoling-gallery

[Install]
WantedBy=multi-user.target
